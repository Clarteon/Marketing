# Editor defaults so formatters and editors agree on the basics.
# Line endings are handled by git (.gitattributes, `* text=auto`) and
# Prettier (`endOfLine: "auto"`), so they are deliberately not set here.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
