# Public site settings
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ALLOW_INDEXING=

# Chat model (Groq)
GROQ_API_KEY=
LLM_MODEL_PRIMARY=
LLM_MODEL_FALLBACKS=
LLM_PROMPT_GUARD_MODEL=

# Google Calendar (OAuth)
# Enable the Google Calendar API, create an OAuth client of type Desktop app
# (or a Web application client with the loopback redirect URI below), then run:
# npm run google:oauth
# GOOGLE_CALENDAR_ID is "primary" or the calendar's Calendar ID. Use
# admin@clarteon.tech for the booking calendar.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Legacy service-account fields are not used by the OAuth booking flow.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Lead database (Neon Postgres)
DATABASE_URL=

# Form bot protection (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email (Resend)
# EMAIL_FROM format: Clarteon <info@clarteon.tech>
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
TEAM_ALERT_EMAIL=

# Sync and admin
SYNC_SECRET=
ADMIN_AUTH_SECRET=

# Limits
RATE_LIMIT_WINDOW_SECONDS=
RATE_LIMIT_MAX_REQUESTS=
CHAT_MAX_MESSAGES=

# Alerts: email the team once a day when sends pass this count (default 80 of Resend's 100/day)
EMAIL_DAILY_ALERT_THRESHOLD=

# Analytics (Cloudflare Web Analytics site token). Set for Production only.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Lead and booking backups (npm run db:backup). At least 16 characters; keep it in a password manager.
BACKUP_PASSPHRASE=
